# Copy to .env and edit. .env is gitignored.

# Required: package name of the installed app to test (not the display name).
# Find it with: adb shell pm list packages -3
APP_PACKAGE=com.example.myapp

# Spotify website test (python run.py --web spotify): phone number to type on the sign-up page.
# Enter it the way the page's field expects it (check whether it wants the country code).
SPOTIFY_PHONE=

# Uber website test (python run.py --web uber): phone number for the sign-up page.
# Include the country code (e.g. +918459292374) - a bare number gets whatever country
# Uber guesses from the exit IP, which through Bright Data is not always India.
UBER_PHONE=

# Bright Data proxy for website tests (residential or Web Unlocker zone - same auth either way).
# Leave all blank to run without a proxy. Get these from your Bright Data zone's dashboard.
BRIGHTDATA_HOST=
BRIGHTDATA_PORT=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# Bright Data Browser API (a.k.a. "Scraping Browser") - a SEPARATE zone from the one above.
# This is the one that can actually solve a CAPTCHA mid-session; the residential/Web Unlocker
# zone above only changes your IP. Create a "Browser API" zone in your dashboard for these.
BRIGHTDATA_BROWSER_USERNAME=
BRIGHTDATA_BROWSER_PASSWORD=

# Optional. HEADLESS=1 also runs the website tests without a visible Chrome window.
# NOTE: SeleniumBase CDP avoidance needs a window for max stealth - keep HEADLESS=0
# for Uber runs unless you accept a higher challenge rate.
AVD_NAME=emu_test
HEADLESS=0
# SeleniumBase CDP avoidance (Uber spike): locale/timezone must match exit IP.
# Blank SB_PROXY derives "user:pass@host:port" from the Bright Data settings above;
# set SB_PROXY=none to force a direct connection, or paste a full proxy string.
# SB_SESSION pins one sticky exit IP per run (Bright Data -session- suffix);
# blank mints a random one so runs don't share a burned IP.
SB_LANG=en-US
SB_TZ=Asia/Kolkata
SB_USER_DATA_DIR=
SB_PROXY=
SB_SESSION=
BOOT_TIMEOUT=240
APPIUM_URL=http://127.0.0.1:4723
# ANDROID_HOME=/Users/you/Library/Android/sdk
