# Copy to .env and edit. .env is gitignored.

# Required: package name of the installed app to test (not the display name).
# Find it with: adb shell pm list packages -3
APP_PACKAGE=com.example.myapp

# Spotify website test (python run.py --web spotify): phone number to type on the sign-up page.
# Enter it the way the page's field expects it (check whether it wants the country code).
SPOTIFY_PHONE=

# Uber website test (python run.py --web uber): phone number for the sign-up page.
# Include the country code (e.g. +918459292374).
UBER_PHONE=

# CapSolver (replaces Bright Data for CAPTCHA solving). Fund at capsolver.com,
# then paste the key here. Blank = detection-only: challenges report as
# "captcha" but are never solved.
CAPSOLVER_API_KEY=
# Seconds per CapSolver FunCaptcha solve (15-60s typical).
CAPSOLVER_TIMEOUT=120

# Bright Data Residential IP proxy (core/web/residential_proxy.py). Create a
# Residential zone at brightdata.com/cp/zones, then set these three. Blank =
# not configured, browsers run direct. Pick the exit country per run with
# `python run.py --web <name> --country <cc>` (e.g. --country us) instead of
# an env var - see each target's target.py for its default country.
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=
BRIGHTDATA_ZONE_PASSWORD=

# Legacy proxy vars (deprecated, optional, no country targeting). Blank =
# direct connection (default). Used only when the residential vars above
# aren't set. CapSolver itself always uses FunCaptchaTaskProxyless (its own
# IP pool), regardless of this proxy.
BRIGHTDATA_HOST=
BRIGHTDATA_PORT=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# Legacy Bright Data Browser API zone (removed - CapSolver solves in-page now).
# Kept as empty placeholders so old .env files still parse.
BRIGHTDATA_BROWSER_USERNAME=
BRIGHTDATA_BROWSER_PASSWORD=

# Optional. HEADLESS=1 also runs the website tests without a visible Chrome window.
# NOTE: SeleniumBase CDP avoidance needs a window for max stealth - keep HEADLESS=0
# for Uber runs unless you accept a higher challenge rate.
AVD_NAME=emu_test
HEADLESS=0
# SeleniumBase CDP (Uber flow): locale/timezone for header coherence.
# SB_PROXY="none" forces direct; a full "user:pass@host:port" uses a proxy.
# SB_SESSION is reserved for proxy sticky sessions; unused on direct.
SB_LANG=en-US
SB_TZ=Asia/Kolkata
SB_USER_DATA_DIR=
SB_PROXY=
SB_SESSION=
BOOT_TIMEOUT=240
APPIUM_URL=http://127.0.0.1:4723
# ANDROID_HOME=/Users/you/Library/Android/sdk
